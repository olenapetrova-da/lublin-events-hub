      "parameters": {
        "jsCode": "// Summary – metrics for WF-INGEST\n// Mode: Run Once for All Items\n\nfunction safeNum(v, fallback = 0) {\n  const n = Number(v);\n  return Number.isFinite(n) ? n : fallback;\n}\n\nfunction getFirstJson(nodeName) {\n  try {\n    const it = $items(nodeName);\n    return it?.[0]?.json ?? null;\n  } catch {\n    return null;\n  }\n}\n\n// 1) Config\nconst cfg = getFirstJson('Config – Window & Hub params1') || {};\nconst config = {\n  date: cfg.date ?? null,\n  period: cfg.period ?? null,\n  days: cfg.days ?? null,\n  pages: cfg.pages ?? null,\n  limit: cfg.limit ?? null,\n  include_in_progress: cfg.include_in_progress ?? null,\n};\n\n// 2) Hub telemetry\nconst hubJson = getFirstJson('HTTP – Fetch Hub events1') || {};\nconst hub = {\n  received: safeNum(hubJson.received, null),\n  deduped: safeNum(hubJson.deduped, null),\n  count: safeNum(hubJson.count, null),\n  events_array_length: Array.isArray(hubJson.events) ? hubJson.events.length : null,\n  per_source: Array.isArray(hubJson.per_source) ? hubJson.per_source : null,\n  dedupe_stats: hubJson.dedupe_stats ?? null,\n};\n\n// 3) Events after mapping / event_id\nconst eventItems = $items('Code – compute event_id1') || [];\nconst eventIdToSource = new Map();\nconst eventIdSet = new Set();\nconst eventsPerSource = {};\n\nfor (const it of eventItems) {\n  const j = it.json || {};\n  const eventId = j.event_id;\n  const src = (j.source || 'unknown').trim();\n\n  if (eventId) {\n    eventIdSet.add(eventId);\n    eventIdToSource.set(eventId, src);\n  }\n  eventsPerSource[src] = (eventsPerSource[src] || 0) + 1;\n}\n\n// 4) Showtime rows (planned inserts)\nconst showtimeRows = $items('Code – build showtime rows') || [];\nlet showtimesTimed = 0;\nlet showtimesNoTime = 0;\nconst showtimesPerSource = {};\nconst showtimeKeySet = new Set();\n\nfor (const it of showtimeRows) {\n  const j = it.json || {};\n  const eventId = j.event_id || null;\n  const src = eventIdToSource.get(eventId) || 'unknown';\n\n  const t = j.time ?? null;\n  if (t === null || t === '') showtimesNoTime++;\n  else showtimesTimed++;\n\n  showtimesPerSource[src] = (showtimesPerSource[src] || 0) + 1;\n\n  // uniqueness check (in-workflow diagnostic)\n  const k = [\n    eventId ?? '∅',\n    j.date ?? '∅',\n    (t === null || t === '') ? '∅' : String(t),\n    (j.venue === null || j.venue === '') ? '∅' : String(j.venue),\n  ].join('|');\n  showtimeKeySet.add(k);\n}\n\n// 5) Prune count (if your prune node returns rows like {to_prune: N})\nlet toPrune = null;\ntry {\n  const pruneItems = $items('DB – Prune showtimes') || [];\n  toPrune = pruneItems.reduce((acc, it) => acc + safeNum(it.json?.to_prune, 0), 0);\n} catch {\n  // ignore\n}\n\nreturn [{\n  json: {\n    ran_at: new Date().toISOString(),\n    config,\n    hub,\n    pipeline: {\n      events_total: eventItems.length,\n      events_distinct: eventIdSet.size,\n      events_per_source: eventsPerSource,\n      showtimes_total: showtimeRows.length,\n      showtimes_distinct_in_run: showtimeKeySet.size,\n      showtimes_timed: showtimesTimed,\n      showtimes_no_time: showtimesNoTime,\n      showtimes_per_source: showtimesPerSource,\n    },\n    db: {\n      showtimes_to_prune: toPrune,\n    },\n  }\n}];\n"
      },

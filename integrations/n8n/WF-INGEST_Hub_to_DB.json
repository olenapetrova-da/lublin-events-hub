      "parameters": {
        "jsCode": "// Summary – metrics for WF-INGEST\n// Mode: Run Once for All Items\n\nfunction safeNum(v, fallback = 0) {\n  const n = Number(v);\n  return Number.isFinite(n) ? n : fallback;\n}\n\n// 1) Window config (date / period / days)\nlet config = { date: null, period: null, days: null };\ntry {\n  const cfgItems = $items('Config – Window & Hub params1');\n  if (cfgItems.length && cfgItems[0].json) {\n    const j = cfgItems[0].json;\n    config = {\n      date:   j.date   ?? null,\n      period: j.period ?? null,\n      days:   j.days   ?? null,\n    };\n  }\n} catch (e) {\n  // leave defaults\n}\n\n// 2) Hub telemetry (HTTP – Fetch Hub events)\nlet hub = {\n  received: null,\n  count: null,\n  events_array_length: null,\n  per_source_raw: null,\n};\ntry {\n  const hubItems = $items('HTTP – Fetch Hub events1');\n  if (hubItems.length && hubItems[0].json) {\n    const j = hubItems[0].json;\n    hub.received            = safeNum(j.received, null);\n    hub.count               = safeNum(j.count, null);\n    hub.events_array_length = Array.isArray(j.events) ? j.events.length : null;\n    hub.per_source_raw      = Array.isArray(j.per_source) ? j.per_source : null;\n  }\n} catch (e) {\n  // leave defaults\n}\n\n// 3) Events after mapping / event_id\nconst eventItems = $items('Code – compute event_id1') || [];\nconst eventsTotal = eventItems.length;\n\nconst eventIdSet = new Set();\nconst eventsPerSource = {};\nfor (const it of eventItems) {\n  const j = it.json || {};\n  const id = j.event_id || '';\n  if (id) eventIdSet.add(id);\n\n  const src = j.source || 'unknown';\n  eventsPerSource[src] = (eventsPerSource[src] || 0) + 1;\n}\nconst eventIdsDistinct = eventIdSet.size;\n\n// 4) Showtime rows generated\nconst showtimeItems = $items('Code – build showtime rows') || [];\nconst showtimesGenerated = showtimeItems.length;\n\n// Per-source showtime counts (infer source from event_id prefix)\nconst showtimesPerSource = {};\nfor (const it of showtimeItems) {\n  const j = it.json || {};\n  const eventId = j.event_id || '';\n  const src = eventId.split('|')[0] || 'unknown';\n  showtimesPerSource[src] = (showtimesPerSource[src] || 0) + 1;\n}\n\n// 5) Showtimes deleted by prune step\nconst prunedItems = $items('DB – Prune showtimes') || [];\nconst showtimesDeleted = prunedItems.length;\n\n// 6) Build final summary object\nconst summary = {\n  window: {\n    date:   config.date,\n    period: config.period,\n    days:   config.days,\n  },\n  hub: {\n    received:            hub.received,\n    count:               hub.count,\n    events_array_length: hub.events_array_length,\n    per_source_raw:      hub.per_source_raw,\n  },\n  events: {\n    total_items_after_mapping: eventsTotal,\n    distinct_event_id:         eventIdsDistinct,\n    per_source:                eventsPerSource,\n  },\n  showtimes: {\n    generated:       showtimesGenerated,\n    deleted_by_prune: showtimesDeleted,\n    per_source:      showtimesPerSource,\n  },\n};\n\n// Return a single summary item as workflow output\nreturn [\n  {\n    json: summary,\n  },\n];\n"
      },

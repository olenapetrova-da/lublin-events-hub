    {
      "parameters": {
        "operation": "executeQuery",
        "query": "DELETE FROM public.showtimes\nWHERE _end_date < '{{$json[\"date\"]}}'::date\n   OR date > '{{$json[\"date\"]}}'::date + INTERVAL '6 days'\nRETURNING showtime_id,\n          event_id,\n          date,\n          _end_date,\n          venue,\n          payment;\n",
        "options": {}

{
  "name": "WF-INGEST – Hub → DB",
  "nodes": [
    {
      "parameters": {
        "jsCode": "// Build showtime rows from events that already have event_id\n// Mode: Run Once for All Items\n\nconst out = [];\n\nfunction safeStr(v) {\n  return v == null ? '' : String(v).trim();\n}\n\n// Payment mapping: Hub \"Payment for Entry\" → free|paid|unknown\nfunction mapPayment(raw) {\n  const s = safeStr(raw).toLowerCase();\n  if (!s) return 'unknown';\n\n  if (\n    s.includes('bezpłat') || s.includes('bezplat') ||\n    s.includes('wstęp wolny') || s.includes('wstep wolny')\n  ) {\n    return 'free';\n  }\n\n  if (\n    s.includes('płat') || s.includes('plat') ||\n    s.includes('bilet') || s.includes('wejściówk') || s.includes('wejsciowk')\n  ) {\n    return 'paid';\n  }\n\n  return 'unknown';\n}\n\nfor (const item of items) {\n  const row = item.json;\n\n  // event_id must already be set by \"Code – compute event_id\"\n  const eventId = safeStr(row.event_id);\n  if (!eventId) {\n    // If for some reason there is no event_id, skip this row to avoid FK errors\n    continue;\n  }\n\n  const dateStr     = safeStr(row.date_str || row.Date);\n  const timeStrRaw  = safeStr(row.time_str || row.Time);\n  const endDateStr0 = safeStr(row.end_date_str || row._EndDate || row._end_date);\n  const endDateStr  = endDateStr0 || dateStr;\n\n  const venueRaw = safeStr(row.venue_raw || row.Venue || row.venue);\n  const venue    = venueRaw.replace(/\\s+/g, ' ').trim();\n\n  const payRaw  = row['Payment for Entry'] ?? row.payment_raw ?? row.payment;\n  const payment = mapPayment(payRaw);\n\n  // Split times by comma/semicolon, keep non-empty tokens\n  let times = [];\n  if (timeStrRaw) {\n    times = timeStrRaw\n      .split(/[;,]/)\n      .map(t => safeStr(t))\n      .filter(Boolean);\n  }\n\n  // Case A: single-day, timed event (Date == _EndDate, Time not empty)\n  if (dateStr && times.length > 0 && endDateStr === dateStr) {\n    for (const t of times) {\n      out.push({\n        json: {\n          event_id:  eventId,\n          date:      dateStr,\n          time:      t,\n          _end_date: dateStr,\n          venue,\n          payment,\n        },\n      });\n    }\n    continue;\n  }\n\n  // Case C: multi-day, no-time (Time empty, _EndDate > Date)\n  if (dateStr && !timeStrRaw && endDateStr && endDateStr !== dateStr) {\n    out.push({\n      json: {\n        event_id:  eventId,\n        date:      dateStr,\n        time:      null,\n        _end_date: endDateStr,\n        venue,\n        payment,\n      },\n    });\n    continue;\n  }\n\n  // Case B: single-day, no-time (Time empty, _EndDate == Date or empty)\n  if (dateStr && !timeStrRaw) {\n    out.push({\n      json: {\n        event_id:  eventId,\n        date:      dateStr,\n        time:      null,\n        _end_date: dateStr,\n        venue,\n        payment,\n      },\n    });\n    continue;\n  }\n\n  // Fallback: weird combinations – best effort, one row using first time token (if any)\n  if (dateStr) {\n    const t = times[0] || null;\n    out.push({\n      json: {\n        event_id:  eventId,\n        date:      dateStr,\n        time:      t,\n        _end_date: endDateStr || dateStr,\n        venue,\n        payment,\n      },\n    });\n  }\n}\n\nreturn out;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2144,
        640
      ],
      "id": "bee9408d-4a5c-43b4-a5a3-ab2d4cfb3578",
      "name": "Code – build showtime rows"

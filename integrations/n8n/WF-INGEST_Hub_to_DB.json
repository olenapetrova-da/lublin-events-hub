        "query": "INSERT INTO public.showtimes (\n  event_id,\n  date,\n  time,\n  _end_date,\n  venue,\n  payment\n)\nSELECT\n  '{{$json[\"event_id\"]}}',\n  '{{$json[\"date\"]}}'::date,\n  NULL::time,\n  '{{$json[\"_end_date\"]}}'::date,\n  '{{$json[\"venue\"]}}',\n  '{{$json[\"payment\"]}}'\nWHERE NOT EXISTS (\n  SELECT 1\n  FROM public.showtimes s\n  WHERE s.event_id = '{{$json[\"event_id\"]}}'\n    AND s.date     = '{{$json[\"date\"]}}'::date\n    AND s.time IS NULL\n    AND s.venue    = '{{$json[\"venue\"]}}'\n);\n",

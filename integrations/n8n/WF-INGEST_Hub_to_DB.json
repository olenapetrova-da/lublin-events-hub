    {
      "parameters": {
        "jsCode": "// Mode: Run Once for All Items\n// Compute a stable event_id that does NOT depend on date/time.\n// One ID per (source, title, venue, url).\n\nfunction normalizeForId(s) {\n  if (!s) return '';\n  let out = String(s).normalize('NFD').replace(/[\\u0300-\\u036f]/g, '');\n  out = out\n    .replace(/ł/g, 'l')\n    .replace(/Ł/g, 'L')\n    .replace(/ß/g, 'ss');\n  out = out.replace(/\\s+/g, ' ').trim().toLowerCase();\n  return out;\n}\n\nreturn items.map(item => {\n  const j = item.json;\n\n  const source    = j.source || 'unknown';           // 'zoom', 'official', ...\n  const titleNorm = normalizeForId(j.title || '');\n  const venueNorm = normalizeForId(j.venue_raw || '');\n  const url       = j.url || '';\n\n  // No date/time here on purpose\n  j.event_id = `${source}|${titleNorm}|${venueNorm}|${url}`;\n\n  return item;\n});\n"
      },
